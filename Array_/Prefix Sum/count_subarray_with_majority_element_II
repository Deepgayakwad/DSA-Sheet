class Solution {
public:
    long long countMajoritySubarrays(vector<int>& nums, int target) {
        
         long long n = nums.size();
         long long result = 0;
         long long leftPoints = 0;

         long long cumSum = 0;

         unordered_map<int,int>mpp;
         mpp[0] = 1;

         for(int i = 0;i < n;i++){
              
               if(nums[i] == target){
                  
                     leftPoints += mpp[cumSum];
                     cumSum += 1;
               }
               else{
                   
                     cumSum -= 1;
                     leftPoints -= mpp[cumSum];
               }

               result += leftPoints;
               mpp[cumSum]++;

         }

         return result;
    }
};