class Solution {
public:

   long long  findTHours(vector<int>& piles,int mid){
       
           long long  total=0;

          for(int i=0;i<piles.size();i++){
              
              total+=ceil((double)piles[i]/(double)mid);
          }

          return total;
   }
    int minEatingSpeed(vector<int>& piles, int h) {

         int n=piles.size();

        int low=1;
        int high=*max_element(piles.begin(),piles.end());

       long long minSpeed=INT_MAX;


        while(low<=high){

             long long mid=low+(high-low)/2;

             long long  totalHours=findTHours(piles,mid);

             if(totalHours<=h){
                  minSpeed=min(minSpeed,mid);
                  high=mid-1;
             }
             else{
                low=mid+1;
             }
        }

        return minSpeed;
        
    }
};
