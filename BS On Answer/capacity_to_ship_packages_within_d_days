class Solution {
public:

   int findTDays(vector<int>&weights,int capacity){
        
         int totalDays=0;
         int sum=0;

         for(int i=0;i<weights.size();i++){
              
               if(sum+weights[i]<=capacity){
                   
                    sum+=weights[i];
               }
               else{
                  
                   totalDays++;
                   sum=0;
                   sum+=weights[i];
               }
         }

        return totalDays+1;
   }
    int shipWithinDays(vector<int>& weights, int days) {

        int low=*max_element(weights.begin(),weights.end());
        int high=0;

        for(int i=0;i<weights.size();i++){
              high+=weights[i];
        }
        
        int minCapacity=INT_MAX;

        while(low<=high){

             int mid=low+(high-low)/2;

             int TDays=findTDays(weights,mid);

             if(TDays<=days){
                  
                  minCapacity=min(minCapacity,mid);
                  high=mid-1;
             }
             else{
                  
                   low=mid+1;
             }

               
        }

        return minCapacity;
        
    }
};
